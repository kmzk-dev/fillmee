---
import { getCollection, render } from 'astro:content';
import ContactForm from '../../components/ContactForm.astro';
import PrivacyPolicyModal from '../../components/PrivacyPolicyModal.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import '../../style/global.css';

export async function getStaticPaths() {
  const legals = await getCollection('legal');
  return legals.map(entry => ({
    params: { slug: entry.id.replace(/\.md$/, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const products = await getCollection('product');
const currentLegalSlug = entry.id.replace(/\.md$/, '');
const relatedProduct = products.find(item => item.data.legalSlug === currentLegalSlug);
const productPath = relatedProduct ? `/product/${relatedProduct.id.replace(/\.md$/, '')}` : '/';
const storeUrl = relatedProduct?.data.storeUrl ?? '';
const { Content } = await render(entry);
---

<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{entry.data.title}</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <script src="https://www.google.com/recaptcha/api.js" async defer></script>
</head>
<body class="bg-light text-start">
  <SiteHeader variant="legal" productPath={productPath} storeUrl={storeUrl} />

  <main class="py-5">
    <div class="container" style="max-width: 800px;">
      <div class="card p-4 p-md-5 rounded-4 border-0 shadow-sm bg-white">
        <span class="badge bg-success-subtle text-success border border-success-subtle align-self-start px-3 py-1.5 rounded-pill mb-2">Legal Policy</span>
        <h1 class="h3 fw-bold text-dark mb-2">{entry.data.title}</h1>
        <p class="text-muted small mb-4">最終改定日: {entry.data.lastUpdated}</p>
        <div class="border-top pt-4 markdown-body">
          <Content />
        </div>
      </div>

      <ContactForm applicationName={relatedProduct?.data.title ?? entry.data.productName} formId={`${currentLegalSlug}-contact-form`} />
    </div>
  </main>

  <PrivacyPolicyModal />

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>