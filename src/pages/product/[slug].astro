---
import { getCollection, render } from 'astro:content';
import ContactForm from '../../components/ContactForm.astro';
import PrivacyPolicyModal from '../../components/PrivacyPolicyModal.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import '../../style/global.css';

export async function getStaticPaths() {
  const products = await getCollection('product');
  return products.map(entry => ({
    params: { slug: entry.id.replace(/\.md$/, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{entry.data.title} - 使い方＆ドキュメント</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <script src="https://www.google.com/recaptcha/api.js" async defer></script>
</head>
<body class="bg-light text-start">
  <SiteHeader variant="product" legalPath={`/legal/${entry.data.legalSlug}`} storeUrl={entry.data.storeUrl} />

  <main class="py-5">
    <div class="container" style="max-width: 800px;">
      <div class="card p-4 p-md-5 rounded-4 border-0 shadow-sm bg-white mb-4">
        <div class="d-flex align-items-center gap-3 mb-3">
          <div>
            <h1 class="h3 fw-bold text-dark mb-1">{entry.data.title}</h1>
            <p class="text-muted mb-0">{entry.data.subtitle}</p>
          </div>
        </div>

        <div class="mb-3">
          {entry.data.category === 'android' && (
            <span class="badge rounded-pill bg-success-subtle text-success border border-success-subtle px-3 py-2 fw-semibold">
              <i class="bi bi-android2 me-1"></i> Android
            </span>
          )}
          {entry.data.category === 'chrome' && (
            <span class="badge rounded-pill bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 fw-semibold">
              <i class="bi bi-browser-chrome me-1"></i> Chrome拡張
            </span>
          )}
          {entry.data.category === 'web' && (
            <span class="badge rounded-pill bg-info-subtle text-info border border-info-subtle px-3 py-2 fw-semibold">
              <i class="bi bi-globe2 me-1"></i> Web / ツール
            </span>
          )}
        </div>

        <div class="border-top pt-4 markdown-body">
          <!-- Markdownの本文がここにHTMLとして自動展開されます -->
          <Content />
        </div>
      </div>

      <ContactForm applicationName={entry.data.title} formId={`${entry.id.replace(/\.md$/, '')}-contact-form`} />
    </div>
  </main>

  <PrivacyPolicyModal />

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>